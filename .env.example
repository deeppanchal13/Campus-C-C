NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key; safe for browser use, but not sufficient for the server upload/admin flow.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only secret key from Supabase Project Settings > API. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=server-only-secret-key
SUPABASE_STORAGE_BUCKET=campus-resources
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt-hash-generated-by-setup-script
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
MAX_UPLOAD_BYTES=10485760
NEXT_PUBLIC_MAX_UPLOAD_BYTES=10485760
UPLOADS_PER_HOUR=5
NEXT_PUBLIC_APP_URL=http://localhost:3000
